# Copy to .env (next to shazam_stats.py) and fill in. .env is git-ignored.
# Precedence: CLI flag -> real environment variable -> .env -> default.

# What to collect: shazam, youtube, or shazam,youtube. The first one is the
# default sort column. Default: shazam, plus youtube when a key is set.
# Set SOURCES=shazam to turn YouTube off without removing the key.
SOURCES=shazam,youtube

# YouTube Data API v3 key (free): https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for the key's project. A full catalog run costs
# ~20 quota units (+100 for the Topic channel search) of 10,000/day.
YOUTUBE_API_KEY=
